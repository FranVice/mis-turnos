# Copia este archivo como .env y rellena los dos valores.
# Supabase > Project Settings > API Keys (usa SOLO la clave publicable: sb_publishable_...).
# NUNCA pongas aquí la clave secreta (sb_secret_...) ni la service_role.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Pon 1 para forzar el modo demostración aunque haya credenciales.
EXPO_PUBLIC_DEMO=0
